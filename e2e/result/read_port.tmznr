import std.fmt;
import std.io;
import std.result;

type ReadError enum {
    ShortInput
}

function read_port(data: []const Byte): result.Result<UInt16, ReadError> {
    // This guard returns ShortInput in every build mode.
    if (len(value: data) < 2usize) {
        return result.Err(error: ShortInput);
    }
    port := (UInt16(value: data[0usize]) << 8u16) | UInt16(value: data[1usize]);
    return result.Ok(value: port);
}

function report(out: io.Writer, port: result.Result<UInt16, ReadError>) {
    switch (port) {
    case result.Ok(value: port_number):
        fmt.write(to: out, format: "{}\n", value: port_number);
    case result.Err(error: ShortInput):
        fmt.write(to: out, format: "{}\n", value: "short input");
    }
}

function main() {
    out := io.stdout();
    data := [2usize]Byte{0x01u8, 0xbbu8};
    report(out: out, port: read_port(data: data[:]));
    report(out: out, port: read_port(data: data[:1usize]));
    // For this one-byte view, reading index 1usize directly would trap in Debug
    // and ReleaseSafe (the default release mode). In ReleaseFast it is unchecked
    // and the behavior is undefined.
}

// Output:
// 443
// short input
