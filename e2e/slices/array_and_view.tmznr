import std.fmt;
import std.io;

function main() {
    out := io.stdout();
    bytes := [4usize]Byte{10u8, 20u8, 30u8, 40u8};
    snapshot := bytes;
    var middle: []const Byte = bytes[1usize:3usize];

    index := 1u16;
    // Rejected: bytes[index] = 99u8; a slice or array index must be USize.
    bytes[USize(value: index)] = 99u8;
    fmt.write(to: out, format: "{}\n", value: snapshot[1usize]);
    fmt.write(to: out, format: "{}\n", value: middle[0usize]);
    fmt.write(to: out, format: "{}\n", value: len(value: middle));
}

// Output:
// 20
// 99
// 2
