import std.fmt;
import std.io;
import std.iter;
import std.option;

function find_byte(data: []const Byte, target: Byte): option.Option<USize> {
    return iter.range(start: 0usize, end: len(value: data))
        .find(predicate: function (i: USize): Bool {
            return data[i] == target;
        });
}

function report(out: io.Writer, position: option.Option<USize>) {
    switch (position) {
    case option.Some(value: i):
        fmt.write(to: out, format: "{}\n", value: i);
    case option.None:
        fmt.write(to: out, format: "{}\n", value: "missing");
    }
}

function main() {
    out := io.stdout();
    data := [3usize]Byte{0x00u8, 0xffu8, 0xffu8};
    report(out: out, position: find_byte(data: data[:], target: 0x00u8));
    report(out: out, position: find_byte(data: data[:], target: 0xffu8));
    report(out: out, position: find_byte(data: data[:], target: 0x7fu8));
    report(out: out, position: find_byte(data: data[:0usize], target: 0x00u8));
}

// Output:
// 0
// 1
// missing
// missing
