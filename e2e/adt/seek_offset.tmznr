import std.fmt;
import std.io;

type Seek enum {
    Start
    Relative(delta: ISize)
}

function offset(current: ISize, seek: Seek): ISize {
    switch (seek) {
    case Start:
        return 0isize;
    case Relative(delta: n):
        return current + n;
    }
}

function main() {
    out := io.stdout();
    fmt.write(to: out, format: "{}\n", value: offset(current: 12isize, seek: Start));
    fmt.write(to: out, format: "{}\n", value: offset(current: 12isize, seek: Relative(delta: -4isize)));
}

// Output:
// 0
// 8
