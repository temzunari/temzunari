import std.fmt;
import std.io;

function sum_odd(limit: Int32): Int32 {
    sum := 0i32;
    for (n := 1i32; n <= limit; n++) {
        if (n % 2i32 == 1i32) {
            sum += n;
        }
    }
    return sum;
}

function main() {
    out := io.stdout();
    fmt.write(to: out, format: "{}\n", value: sum_odd(limit: 6i32));
}

// Output:
// 9
