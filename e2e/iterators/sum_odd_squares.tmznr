import std.fmt;
import std.io;
import std.iter;

function is_odd(value: Int32): Bool {
    return value % 2i32 != 0i32;
}

function square(value: Int32): Int32 {
    return value * value;
}

function add(total: Int32, value: Int32): Int32 {
    return total + value;
}

function sum_odd_squares(data: []const Int32): Int32 {
    return iter.from_slice(data: data)
        .filter(predicate: is_odd)
        .map(transform: square)
        .fold_left(initial: 0i32, combine: add);
}

function main() {
    out := io.stdout();
    values := [5usize]Int32{-3i32, 2i32, 1i32, 4i32, 5i32};
    fmt.write(to: out, format: "{}\n", value: sum_odd_squares(data: values[:]));
    fmt.write(to: out, format: "{}\n", value: sum_odd_squares(data: values[:0usize]));
}

// Output:
// 35
// 0
